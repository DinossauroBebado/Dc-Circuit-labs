# Copie para .env e preencha antes do build de produção.

# Google Analytics 4 — o ID da DC (G-HGCCEFZX6B) já está no código (src/layouts/Base.astro).
# Preencha só para usar outra propriedade (ex.: testes).
PUBLIC_GA4_ID=

# Google Search Console — só o valor do "content" da meta tag de verificação
# (Configurações > Verificação de propriedade > Tag HTML).
# Alternativa: verificar pelo DNS (registro TXT na HostGator) e deixar isto vazio.
PUBLIC_GSC_VERIFICATION=

# Cases e apoios sem autorização por escrito ficam FORA do build de produção.
# Em `npm run dev` eles sempre aparecem, com o selo "Pendente de autorização".
# Só mude para true para gerar uma prévia local completa com `npm run build`.
INCLUIR_NAO_AUTORIZADOS=false
