---
// Visualizador 3D com <model-viewer>. A biblioteca (~1 MB) só é baixada quando o visualizador chega
// perto da tela; em conexão lenta ou com economia de dados, fica a imagem estática e um botão
// "Carregar modelo 3D". Sem WebGL, a imagem estática continua visível.
import { MIDIA, type IdMidia, type Midia } from '../data/midia';
import { t, type Idioma } from '../i18n';

interface Props {
  id: IdMidia;
  lang: Idioma;
  /** Mostra o controle "Montado ↔ Explodido" (o GLB precisa ter uma animação chamada "explodir"). */
  explodido?: boolean;
}

const { id, lang, explodido = false } = Astro.props;
const m: Midia = MIDIA[id];
const d = t(lang);
---

{m.src && (
<figure class="v3d" data-v3d>
  <div class="v3d__palco">
    {m.poster && <img class="v3d__poster" src={m.poster} alt={m.alt[lang]} loading="lazy" decoding="async" />}
    <model-viewer
      src={m.src}
      alt={m.alt[lang]}
      camera-controls
      touch-action="pan-y"
      interaction-prompt="none"
      camera-orbit="35deg 62deg auto"
      shadow-intensity="0"
      exposure="1.1"
      tone-mapping="neutral"
      loading="lazy"
      reveal="auto"
      animation-name={explodido ? 'explodir' : undefined}></model-viewer>
    <button type="button" class="btn btn--primario v3d__carregar" data-v3d-carregar>
      {d.comum.carregar3d}
    </button>
  </div>
  {
    explodido && (
      <div class="v3d__explosao">
        <span aria-hidden="true">{d.comum.montado}</span>
        <input
          type="range"
          min="0"
          max="1"
          step="0.01"
          value="0"
          aria-label={d.comum.vistaExplodida}
          data-v3d-explodir
          disabled
        />
        <span aria-hidden="true">{d.comum.explodido}</span>
      </div>
    )
  }
  <figcaption class="v3d__dica">{d.comum.dica3d}</figcaption>
</figure>
)}

<script>
  import '../scripts/visualizador';
</script>

<style>
  .v3d {
    display: grid;
    gap: var(--space-4);
  }
  .v3d__palco {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 35%, rgb(0 123 255 / 0.28), transparent 65%),
      linear-gradient(180deg, #16202c, var(--ink-strong));
    box-shadow: inset 0 0 0 1px rgb(0 237 255 / 0.18);
  }
  .v3d__poster,
  model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .v3d__poster {
    object-fit: cover;
    transition: opacity 0.6s var(--suave);
  }
  model-viewer {
    --poster-color: transparent;
    background: transparent;
  }
  .v3d.carregado .v3d__poster {
    opacity: 0;
  }
  .v3d__carregar {
    position: absolute;
    left: 50%;
    bottom: 20px;
    translate: -50% 0;
  }
  .v3d__explosao {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: 0.85rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.8);
  }
  .v3d__explosao input {
    flex: 1;
    accent-color: var(--accent-cyan);
  }
  .v3d__dica {
    font-size: 0.8rem;
    color: var(--ink-muted);
  }
</style>
