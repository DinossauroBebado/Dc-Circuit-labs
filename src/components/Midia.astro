---
// Foto ou vídeo do manifesto src/data/midia.ts. Item sem `src` não renderiza nada —
// quem usa o componente envolve o bloco em `temMidia(id)` para o layout se ajustar.
import { MIDIA, type IdMidia, type Midia } from '../data/midia';
import type { Idioma } from '../i18n';

interface Props {
  id: IdMidia;
  lang: Idioma;
  class?: string;
  prioridade?: boolean;
}

const { id, lang, class: classe, prioridade = false } = Astro.props;
const m: Midia = MIDIA[id];
const alt = m.alt[lang];
---

{
  m.src && m.tipo === 'video' && (
    <video
      class:list={['midia', classe]}
      autoplay
      muted
      loop
      playsinline
      preload={prioridade ? 'auto' : 'metadata'}
      poster={m.poster}
      aria-label={alt}
      data-video-auto
    >
      <source src={m.src} type="video/mp4" />
    </video>
  )
}
{
  m.src && m.tipo === 'imagem' && (
    <img
      class:list={['midia', classe]}
      src={m.src}
      alt={alt}
      loading={prioridade ? 'eager' : 'lazy'}
      fetchpriority={prioridade ? 'high' : undefined}
      decoding="async"
    />
  )
}

<style>
  .midia {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
