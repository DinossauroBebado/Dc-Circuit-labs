---
// Aviso de cookies (LGPD). Só é renderizado quando PUBLIC_GA4_ID está configurado.
// Nenhuma requisição ao Google acontece antes de o visitante aceitar (ver src/scripts/site.ts).
import { t, type Idioma } from '../i18n';

interface Props {
  lang: Idioma;
}

const d = t(Astro.props.lang).consentimento;
---

<div class="consentimento" data-consentimento hidden role="region" aria-label="Cookies">
  <p>{d.texto}</p>
  <div class="consentimento__botoes">
    <button type="button" class="btn btn--secundario" data-consentir="recusado">{d.recusar}</button>
    <button type="button" class="btn btn--primario" data-consentir="aceito">{d.aceitar}</button>
  </div>
</div>

<style>
  .consentimento {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 1500;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
    max-width: 760px;
    margin-inline: auto;
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: 0 20px 60px rgb(18 18 18 / 0.18);
    font-size: 0.9rem;
  }
  .consentimento[hidden] {
    display: none;
  }
  .consentimento p {
    flex: 1 1 320px;
  }
  .consentimento__botoes {
    display: flex;
    gap: var(--space-3);
  }
  .consentimento .btn {
    padding: 8px 20px;
  }
</style>
