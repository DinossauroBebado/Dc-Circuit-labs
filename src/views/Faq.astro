---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Icone from '../components/Icone.astro';
import { CONTATO, t, urlPagina, type Idioma } from '../i18n';
import { perguntasFrequentes } from '../lib/schema';

interface Props {
  lang: Idioma;
}

const { lang } = Astro.props;
const d = t(lang);
const f = d.faq;
---

<Base lang={lang} caminho="faq/" titulo={f.titulo} descricao={f.descricao} schemas={[perguntasFrequentes(lang)]}>
  <CabecalhoPagina eyebrow={f.eyebrow} titulo={f.h1} lead={f.lead} />

  <section id="perguntas-frequentes" data-secao class="secao faq">
    <div class="container--estreito">
      {
        f.perguntas.map((q, i) => (
          <details class="pergunta revelar" style={`--atraso: ${Math.min(i, 4) * 0.04}s`} open={i === 0}>
            <summary>
              <h2>{q.p}</h2>
              <span class="pergunta__icone" aria-hidden="true">
                <Icone nome="chevron-down" tamanho={22} />
              </span>
            </summary>
            <p>{q.r}</p>
          </details>
        ))
      }

      <div class="mais revelar">
        <h2 class="titulo-card">{f.maisDuvidas}</h2>
        <p>{f.maisDuvidasTexto}</p>
        <div class="botoes">
          <a class="btn btn--primario" href={urlPagina(lang, 'contato')}>{d.comum.iniciarProjeto}</a>
          <a class="btn btn--secundario" href={`https://wa.me/${CONTATO.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .faq {
    padding-top: 0;
  }
  .pergunta {
    border-top: 1px solid rgb(18 18 18 / 0.12);
  }
  .pergunta:last-of-type {
    border-bottom: 1px solid rgb(18 18 18 / 0.12);
  }
  .pergunta summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-6);
    cursor: pointer;
    list-style: none;
  }
  .pergunta summary::-webkit-details-marker {
    display: none;
  }
  .pergunta h2 {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.3;
    transition: color 0.2s;
  }
  .pergunta summary:hover h2 {
    color: var(--brand-blue);
  }
  .pergunta__icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgb(18 18 18 / 0.15);
    transition: transform 0.35s var(--suave), border-color 0.3s, box-shadow 0.3s;
  }
  .pergunta[open] .pergunta__icone {
    transform: rotate(180deg);
    border-color: var(--accent-cyan);
    box-shadow: var(--cyan-brilho);
  }
  .pergunta p {
    padding-bottom: var(--space-6);
    font-size: 1.0625rem;
    max-width: 62ch;
  }
  .mais {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin-top: clamp(56px, 8vw, 96px);
    padding: clamp(32px, 4vw, 48px);
    border-radius: var(--radius-md);
    background: var(--surface-subtle);
  }
  .mais .botoes {
    margin-top: var(--space-3);
  }
</style>
