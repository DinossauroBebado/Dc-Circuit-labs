---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Midia from '../components/Midia.astro';
import Icone from '../components/Icone.astro';
import Processo from '../components/Processo.astro';
import CtaFases from '../components/CtaFases.astro';
import { t, urlPagina, type Idioma } from '../i18n';
import { SERVICOS, type SlugServico } from '../data/servicos';
import { temMidia } from '../data/midia';
import { servico, trilhaDeNavegacao } from '../lib/schema';

interface Props {
  lang: Idioma;
  slug: SlugServico;
}

const { lang, slug } = Astro.props;
const d = t(lang);
const s = d.servicos[slug];
const dados = SERVICOS.find((x) => x.slug === slug)!;
const outros = SERVICOS.filter((x) => x.slug !== slug);
const caminho = `servicos/${slug}/`;
const schemas = [
  servico(lang, slug),
  trilhaDeNavegacao(
    [
      { nome: 'DC Circuit Labs', caminho: '' },
      { nome: d.nav.servicos, caminho: 'servicos/' },
      { nome: s.nome, caminho },
    ],
    lang,
  ),
];
---

<Base lang={lang} caminho={caminho} titulo={`${s.nome} ${d.servico.sufixoTitulo}`} descricao={s.descricao} schemas={schemas}>
  <CabecalhoPagina eyebrow={s.nome} titulo={s.h1} lead={s.lead}>
    <div class="botoes acoes-servico revelar">
      <a class="btn btn--primario" href={urlPagina(lang, 'contato')}>{d.comum.iniciarProjeto}</a>
      <a class="btn btn--secundario" href={urlPagina(lang, 'servicos')}>{d.comum.nossosServicos}</a>
    </div>
  </CabecalhoPagina>

  {
    temMidia(dados.midia) && (
      <div class="container midia-destaque revelar">
        <Midia id={dados.midia} lang={lang} prioridade />
      </div>
    )
  }

  <section class="secao">
    <div class="container">
      <header class="cabecalho-secao revelar">
        <p class="eyebrow">{d.servico.entregas}</p>
      </header>
      <ul class="entregas">
        {
          s.entregas.map((e, i) => (
            <li class="entrega revelar" style={`--atraso: ${i * 0.06}s`}>
              <span class="entrega__marca" aria-hidden="true" />
              <h2 class="titulo-card">{e.t}</h2>
              <p>{e.d}</p>
            </li>
          ))
        }
      </ul>
      <div class="stack revelar">
        <p class="eyebrow">{d.servico.stack}</p>
        <ul class="chips">{s.stack.map((item) => <li class="chip">{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <Processo lang={lang} eyebrow={d.servico.processo} />

  <section class="secao sutil">
    <div class="container">
      <header class="cabecalho-secao revelar">
        <p class="eyebrow">{d.servico.outros}</p>
      </header>
      <ul class="outros">
        {
          outros.map((o) => (
            <li>
              <a class="outro card-brilho" href={urlPagina(lang, 'servico', o.slug)}>
                <Icone nome={o.icone} tamanho={26} />
                <span>{d.servicos[o.slug].nome}</span>
                <Icone nome="arrow-up-right" tamanho={20} class="outro__seta" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaFases lang={lang} eyebrow={d.home.cta.eyebrow} titulo={d.servico.ctaTitulo} texto={d.servico.ctaTexto} />
</Base>

<style>
  .acoes-servico {
    margin-top: var(--space-7);
  }
  .midia-destaque {
    aspect-ratio: 21 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .entregas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(32px, 5vw, 64px) clamp(32px, 6vw, 96px);
    padding: 0;
    list-style: none;
  }
  .entrega {
    position: relative;
    padding-top: var(--space-5);
    border-top: 1px solid rgb(18 18 18 / 0.12);
  }
  /* Trecho de trilha que acende no topo de cada entrega */
  .entrega__marca {
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background: var(--brand-blue);
    transition: width 0.6s var(--suave), background 0.6s;
  }
  .entrega:hover .entrega__marca {
    width: 100%;
    background: linear-gradient(90deg, var(--brand-blue), var(--accent-cyan));
  }
  .entrega h2 {
    margin-bottom: var(--space-3);
  }
  .entrega p {
    font-size: 1.0625rem;
  }
  .stack {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .outros {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .outro {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--ink-strong);
    font-weight: 600;
    text-decoration: none;
  }
  .outro > :global(svg:first-child) {
    color: var(--brand-blue);
    flex: none;
  }
  .outro span {
    flex: 1;
  }
  .outro :global(.outro__seta) {
    transition: transform 0.3s var(--suave);
  }
  .outro:hover :global(.outro__seta) {
    transform: translate(3px, -3px);
  }
  @media (max-width: 860px) {
    .entregas,
    .outros {
      grid-template-columns: 1fr;
    }
    .midia-destaque {
      aspect-ratio: 4 / 3;
    }
  }
</style>
