# Copie para .env (no VPS: /srv/apps/portal/.env). Nunca commite o .env.

# Endereço público do portal
PORTAL_URL=https://portal.dccircuitlabs.com

# Banco SQLite e pasta dos arquivos protegidos
DB_ARQUIVO=/srv/apps/portal/dados/portal.db
ARQUIVOS_DIR=/srv/apps/portal/dados/arquivos

# E-mail (Titan). No desenvolvimento: SMTP_HOST=localhost SMTP_PORTA=1025 SMTP_SEGURO=false (Mailpit, ./dev.sh email)
SMTP_HOST=smtp.titan.email
SMTP_PORTA=465
SMTP_SEGURO=true
SMTP_USUARIO=portal@dccircuitlabs.com
SMTP_SENHA=
EMAIL_REMETENTE="DC Circuit Labs <portal@dccircuitlabs.com>"

# No VPS: o Nginx entrega os arquivos protegidos (X-Accel-Redirect). No desenvolvimento, deixe false.
ARQUIVOS_X_ACCEL=false

# Confluence (documentação). Token: id.atlassian.com > Segurança > Criar e gerenciar tokens de API.
CONFLUENCE_URL=https://dccircuitlabs.atlassian.net/wiki
CONFLUENCE_ESPACO=PORTAL
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=

# Bling (NF-e e contas a receber). Desligado por padrão: as notas fiscais são enviadas à mão no painel.
# Para ligar: BLING_ATIVO=true + o app de integração criado em developer.bling.com.br.
BLING_ATIVO=false
# Link de redirecionamento do app: https://portal.dccircuitlabs.com/admin/bling/retorno
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# false desliga a agenda (publicação diária e Bling a cada hora) neste processo
AGENDA=true
